# GitHub Secret Scanner Pro - Пример конфигурации
# Скопируйте этот файл как config_local.py и заполните реальную информацию конфигурации

# ============================================================================
#                              Конфигурация прокси (необязательно)
# ============================================================================
# Если необходимо обращаться к GitHub API или AI API через прокси, установите это значение
# Пустое значение означает прямое подключение
# PROXY_URL=http://127.0.0.1:7890
PROXY_URL=

# ============================================================================
#                           Конфигурация GitHub Token
# ============================================================================
# Вставьте ваш GitHub Personal Access Token (Classic)
# Необходимые разрешения: public_repo
# Способ получения: https://github.com/settings/tokens
# 
# Рекомендуется настроить несколько токенов для повышения лимита API
# Без аутентификации: 10 запросов/мин, С аутентификацией: 30 запросов/мин
# Примеры нескольких токенов:

GITHUB_TOKEN_1=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN_2=ghp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
GITHUB_TOKEN_3=ghp_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz

# Добавьте больше токенов...
# GITHUB_TOKEN_4=
# GITHUB_TOKEN_5=

# ============================================================================
#                              Конфигурация базы данных
# ============================================================================
# Путь к файлу базы данных SQLite
DB_PATH=leaked_keys.db

# ============================================================================
#                              Конфигурация потоков
# ============================================================================
# Количество потоков валидатора (IO-интенсивно, можно установить высокое значение)
CONSUMER_THREADS=20

# ============================================================================
#                              Конфигурация таймаута
# ============================================================================
# Таймаут HTTP-запроса (секунды)
HTTP_TIMEOUT=10

# ============================================================================
#                              Конфигурация параллельности
# ============================================================================
# Максимальная параллельность асинхронной валидации
MAX_CONCURRENT_VALIDATIONS=100

# ============================================================================
#                           Конфигурация прерывателя цепи
# ============================================================================
# Порог последовательных ошибок (срабатывание прерывателя)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Время восстановления прерывателя (секунды)
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Количество пробных запросов в полуоткрытом состоянии
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3
